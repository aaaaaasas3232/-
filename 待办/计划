## 2. schema.js 的形状（**这是核心**）

```js
export const PROMPT_BUILDER_SCHEMA = {
  meta: {
    version: '7.0',
    promptHeader: { ... },       // prompt 开头那两段（角色说明等）
    promptFooter: { ... },       // prompt 收尾段（技术要求等）
  },

  // ── 题目列表 ──
  questions: [
    {
      id: 'basicInfo',
      title: '基本',
      subtitle: '设置 App 的名称、ID 和简要描述',
      fields: [
        { key: 'appName', label: 'App 名称', type: 'text', placeholder: '我的应用' },
        { key: 'appId',   label: 'App ID',  type: 'text', placeholder: 'my-app' },
        { key: 'appDesc', label: '功能描述', type: 'textarea', placeholder: '...', optional: true },
      ],
      // 套答案到 prompt 片段的模板
      promptBlock: {
        heading: '## 基本',
        body: ({ appName, appId, appDesc, className }) => [
          { appName: 'appName', appId: 'appId', className: 'className', desc: 'appDesc?', note: '三选一即可' },
          // 上面这种结构会被 prompt-builder 转成 YAML
        ],
      },
    },
    {
      id: 'pages',
      title: '页面',
      subtitle: '定义主要页面和 Tab 标签',
      fields: [
        { key: 'structure', type: 'selectHeader', options: [...] },
        { key: 'pages',     type: 'pagesList' },
      ],
      promptBlock: { heading: '## 页面', body: ... },
    },
    // ... 共 18 题 + 1 完成页
  ],
};
```

**关键决策**：
- 每题 `fields[]` 描述 UI（type / label / placeholder / options）
- 每题 `promptBlock.body` 是一个**纯函数**，输入是 `answers`，输出是**结构化数据**（对象/数组），不是字符串
- 真正拼字符串在 `prompt-builder.js` 里统一做，**所有题目走同一套 YAML 序列化器**

