{
  "$schema": "https://railway.app/railway.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksJson": {
      "name": "honor-blacklist-server",
      "version": "1.0.0",
      "plain": {
        "nodeVersion": "18"
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "env": {
      "PORT": "3000"
    }
  }
}
