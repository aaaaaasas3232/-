<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>票根式番茄钟</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Helvetica Neue', Arial, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #e0e0e0;
        }
        
        /* 票根主体 */
        .ticket {
            position: relative;
            width: 300px;
            height: 540px;
            background-color: #fff;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        /* 底部锯齿 */
        .bottom-notch {
            position: absolute;
            bottom: -15px;
            left: 10px;
            width: 280px;
            height: 30px;
            display: flex;
            justify-content: space-between;
        }
        
        .bottom-notch span {
            display: block;
            width: 30px;
            height: 30px;
            background: #e0e0e0;
            border-radius: 50%;
            margin: 0 5px;
        }
        
        /* 侧边缺口 */
        .left-notch {
            position: absolute;
            left: -15px;
            top: 405px;
            width: 30px;
            height: 30px;
            background: #e0e0e0;
            border-radius: 50%;
        }
        
        .right-notch {
            position: absolute;
            right: -15px;
            top: 405px;
            width: 30px;
            height: 30px;
            background: #e0e0e0;
            border-radius: 50%;
        }

        /* 番茄钟区域 */
        .pomodoro-section {
            padding: 30px 20px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .pomodoro {
            position: relative;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background-color: #ffffff;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border: 1px solid #ebebeb;
            margin-bottom: 20px;
        }

        .time-display {
            font-size: 36px;
            font-weight: 300;
            color: #333333;
            margin-bottom: 5px;
            letter-spacing: 2px;
        }

        .mode {
            font-size: 12px;
            color: #888888;
            letter-spacing: 1px;
            margin-bottom: 10px;
            font-weight: 400;
        }

        .progress-ring {
            position: absolute;
            width: 170px;
            height: 170px;
            border-radius: 50%;
        }

        .controls {
            display: flex;
            margin-top: 10px;
            gap: 12px;
        }

        button {
            background: #f0f0f0;
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #555555;
        }

        button:hover {
            background: #e5e5e5;
        }

        button:active {
            transform: scale(0.95);
        }

        /* 任务区域 */
        .task-section {
            flex-grow: 1;
            padding: 0 20px;
            border-top: 1px dashed #e0e0e0;
            overflow-y: auto;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0 10px;
            border-bottom: 1px dashed #e0e0e0;
        }

        .section-header h2 {
            font-size: 16px;
            font-weight: 500;
            color: #333;
        }

        /* 任务列表 */
        .task-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 15px;
            padding-bottom: 20px;
        }

        .task-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 15px;
            background-color: #f9f9f9;
            border-radius: 5px;
            font-size: 14px;
        }

        .task-item:hover {
            background-color: #f5f5f5;
        }

        .task-check {
            width: 18px;
            height: 18px;
            border: 1px solid #ccc;
            border-radius: 50%;
            cursor: pointer;
        }

        .task-check.completed {
            background-color: #d4d4d4;
            position: relative;
        }

        .task-check.completed::after {
            content: "✓";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 12px;
        }

        .task-name {
            flex-grow: 1;
            margin-left: 10px;
        }

        .task-time {
            color: #888;
            font-size: 12px;
        }

        /* 添加新任务 */
        .add-task {
            display: flex;
            gap: 10px;
            margin: 15px 0;
        }

        .add-task input {
            flex-grow: 1;
            padding: 8px 12px;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            font-size: 14px;
        }

        .add-task button {
            width: auto;
            height: auto;
            padding: 0 15px;
            border-radius: 4px;
            background: #555;
            color: white;
        }

        .add-task button:hover {
            background: #444;
        }

        /* 统计区域 */
        .stats {
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
            border-top: 1px dashed #e0e0e0;
            margin-top: 15px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 20px;
            font-weight: 300;
            color: #333;
        }

        .stat-label {
            font-size: 12px;
            color: #888;
            margin-top: 5px;
        }

        /* 设置面板 */
        .settings-content {
            height: 0;
            overflow: hidden;
            transition: height 0.3s ease;
        }

        .settings-content.active {
            height: auto;
            padding-top: 15px;
        }

        .settings-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .setting-group {
            display: flex;
            flex-direction: column;
            width: 48%;
        }

        .setting-group label {
            font-size: 12px;
            color: #666;
            margin-bottom: 5px;
        }

        .setting-group input {
            padding: 8px;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            background-color: #fafafa;
            font-size: 14px;
        }

        /* 开关控件 */
        .switch {
            position: relative;
            display: inline-block;
            width: 36px;
            height: 20px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 2px;
            bottom: 2px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: #888;
        }

        input:checked + .slider:before {
            transform: translateX(16px);
        }

        /* 按钮 */
        .btn {
            padding: 8px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s;
        }

        .btn-primary {
            background-color: #555;
            color: white;
        }

        .btn-primary:hover {
            background-color: #444;
        }

        .btn-secondary {
            background-color: #e0e0e0;
            color: #333;
        }

        .btn-secondary:hover {
            background-color: #d0d0d0;
        }

        /* 图标 */
        .material-icons {
            font-family: 'Material Icons';
            font-weight: normal;
            font-style: normal;
            font-size: 18px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            -webkit-font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
        }
    </style>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body>
    <div class="ticket">
        <!-- 底部锯齿 -->
        <div class="bottom-notch">
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
        </div>
        
        <!-- 侧边缺口 -->
        <div class="left-notch"></div>
        <div class="right-notch"></div>
        
        <!-- 番茄钟区域 -->
        <div class="pomodoro-section">
            <div class="pomodoro">
                <svg class="progress-ring" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="46" fill="none" stroke="#f5f5f5" stroke-width="2"></circle>
                    <circle id="progress-circle" cx="50" cy="50" r="46" fill="none" stroke="#d9d9d9" stroke-width="3"
                        stroke-dasharray="289.03" stroke-dashoffset="0" transform="rotate(-90 50 50)"></circle>
                </svg>
                
                <div class="mode">专注时间</div>
                <div class="time-display">25:00</div>
                
                <div class="controls">
                    <button id="start-btn"><i class="material-icons">play_arrow</i></button>
                    <button id="reset-btn"><i class="material-icons">refresh</i></button>
                    <button id="skip-btn"><i class="material-icons">skip_next</i></button>
                </div>
            </div>
        </div>
        
        <!-- 任务区域 -->
        <div class="task-section">
            <div class="section-header">
                <h2>今日计划</h2>
                <button id="settings-btn" style="width: 30px; height: 30px;">
                    <i class="material-icons">settings</i>
                </button>
            </div>
            
            <!-- 添加新任务 -->
            <div class="add-task">
                <input type="text" id="new-task" placeholder="添加新任务...">
                <button id="add-task-btn">添加</button>
            </div>
            
            <!-- 任务列表 -->
            <div class="task-list" id="task-list">
                <!-- 任务会通过JS动态添加 -->
            </div>
            
            <!-- 设置面板 -->
            <div class="settings-content" id="settings-content">
                <div class="settings-row">
                    <div class="setting-group">
                        <label for="focus-time">专注时间（分钟）</label>
                        <input type="number" id="focus-time" value="25" min="1" max="60">
                    </div>
                    <div class="setting-group">
                        <label for="short-break">短休息（分钟）</label>
                        <input type="number" id="short-break" value="5" min="1" max="30">
                    </div>
                </div>
                
                <div class="settings-row">
                    <div class="setting-group">
                        <label for="long-break">长休息（分钟）</label>
                        <input type="number" id="long-break" value="15" min="1" max="60">
                    </div>
                    <div class="setting-group">
                        <label for="cycles">工作周期数</label>
                        <input type="number" id="cycles" value="4" min="1" max="10">
                    </div>
                </div>
                
                <div class="option-group">
                    <label class="switch">
                        <input type="checkbox" id="auto-start">
                        <span class="slider"></span>
                    </label>
                    <label for="auto-start">自动开始下一个周期</label>
                </div>
                
                <div class="option-group">
                    <label class="switch">
                        <input type="checkbox" id="sound-notifications">
                        <span class="slider"></span>
                    </label>
                    <label for="sound-notifications">声音提醒</label>
                </div>
                
                <div class="action-buttons" style="margin-top: 15px;">
                    <button class="btn btn-secondary" id="cancel-settings">取消</button>
                    <button class="btn btn-primary" id="save-settings">保存设置</button>
                </div>
            </div>
            
            <!-- 统计区域 -->
            <div class="stats">
                <div class="stat-item">
                    <div class="stat-value" id="today-pomodoros">0</div>
                    <div class="stat-label">今日番茄数</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="total-time">0</div>
                    <div class="stat-label">专注分钟</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="completion-rate">0%</div>
                    <div class="stat-label">任务完成率</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // DOM元素
        const startBtn = document.getElementById('start-btn');
        const resetBtn = document.getElementById('reset-btn');
        const skipBtn = document.getElementById('skip-btn');
        const settingsBtn = document.getElementById('settings-btn');
        const settingsContent = document.getElementById('settings-content');
        const saveSettingsBtn = document.getElementById('save-settings');
        const cancelSettingsBtn = document.getElementById('cancel-settings');
        const timeDisplay = document.querySelector('.time-display');
        const modeDisplay = document.querySelector('.mode');
        const progressCircle = document.getElementById('progress-circle');
        const todayPomodorosElement = document.getElementById('today-pomodoros');
        const totalTimeElement = document.getElementById('total-time');
        const completionRateElement = document.getElementById('completion-rate');
        const taskList = document.getElementById('task-list');
        const newTaskInput = document.getElementById('new-task');
        const addTaskBtn = document.getElementById('add-task-btn');

        // 设置选项
        const focusTimeInput = document.getElementById('focus-time');
        const shortBreakInput = document.getElementById('short-break');
        const longBreakInput = document.getElementById('long-break');
        const cyclesInput = document.getElementById('cycles');
        const autoStartCheckbox = document.getElementById('auto-start');
        const soundNotificationsCheckbox = document.getElementById('sound-notifications');

        // 番茄钟状态
        let timer;
        let timeLeft = 25 * 60; // 默认25分钟
        let originalTime = 25 * 60;
        let isRunning = false;
        let mode = 'focus'; // focus, shortBreak, longBreak
        let cycleCount = 0;
        let completedPomodoros = 0;
        let totalFocusTime = 0;
        
        // 初始任务
        let tasks = [
            { id: 1, name: "完成项目规划", completed: false },
            { id: 2, name: "阅读技术文档", completed: false },
            { id: 3, name: "整理工作笔记", completed: false }
        ];
        
        let currentTaskId = 1;

        // 圆形进度条
        const circumference = 2 * Math.PI * 46;
        progressCircle.style.strokeDasharray = circumference;
        
        // 更新时间显示
        function updateTimeDisplay() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timeDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            
            // 更新进度圈
            const progress = 1 - (timeLeft / originalTime);
            const dashoffset = circumference * (1 - progress);
            progressCircle.style.strokeDashoffset = dashoffset;
        }

        // 更新模式显示
        function updateModeDisplay() {
            switch(mode) {
                case 'focus':
                    modeDisplay.textContent = "专注时间";
                    break;
                case 'shortBreak':
                    modeDisplay.textContent = "短休息";
                    break;
                case 'longBreak':
                    modeDisplay.textContent = "长休息";
                    break;
            }
        }

        // 开始计时器
        function startTimer() {
            if (isRunning) {
                clearInterval(timer);
                startBtn.innerHTML = '<i class="material-icons">play_arrow</i>';
                isRunning = false;
                return;
            }
            
            startBtn.innerHTML = '<i class="material-icons">pause</i>';
            isRunning = true;
            
            timer = setInterval(() => {
                timeLeft--;
                updateTimeDisplay();
                
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    isRunning = false;
                    startBtn.innerHTML = '<i class="material-icons">play_arrow</i>';
                    
                    // 播放提示音
                    if (soundNotificationsCheckbox.checked) {
                        const audio = new Audio('https://assets.mixkit.co/sfx/preview/mixkit-alarm-digital-clock-beep-989.mp3');
                        audio.play();
                    }
                    
                    // 切换到下一个模式
                    if (mode === 'focus') {
                        completedPomodoros++;
                        todayPomodorosElement.textContent = completedPomodoros;
                        
                        // 更新专注总时间
                        totalFocusTime += parseInt(focusTimeInput.value);
                        totalTimeElement.textContent = totalFocusTime;
                        
                        cycleCount++;
                        
                        if (cycleCount % parseInt(cyclesInput.value) === 0) {
                            mode = 'longBreak';
                            timeLeft = parseInt(longBreakInput.value) * 60;
                        } else {
                            mode = 'shortBreak';
                            timeLeft = parseInt(shortBreakInput.value) * 60;
                        }
                    } else {
                        mode = 'focus';
                        timeLeft = parseInt(focusTimeInput.value) * 60;
                    }
                    
                    originalTime = timeLeft;
                    updateModeDisplay();
                    updateTimeDisplay();
                    
                    // 自动开始下一个周期
                    if (autoStartCheckbox.checked) {
                        startTimer();
                    }
                }
            }, 1000);
        }

        // 重置计时器
        function resetTimer() {
            clearInterval(timer);
            
            if (mode === 'focus') {
                timeLeft = parseInt(focusTimeInput.value) * 60;
            } else if (mode === 'shortBreak') {
                timeLeft = parseInt(shortBreakInput.value) * 60;
            } else {
                timeLeft = parseInt(longBreakInput.value) * 60;
            }
            
            originalTime = timeLeft;
            isRunning = false;
            startBtn.innerHTML = '<i class="material-icons">play_arrow</i>';
            updateTimeDisplay();
        }

        // 跳过当前计时
        function skipTimer() {
            clearInterval(timer);
            isRunning = false;
            startBtn.innerHTML = '<i class="material-icons">play_arrow</i>';
            
            if (mode === 'focus') {
                completedPomodoros++;
                todayPomodorosElement.textContent = completedPomodoros;
                
                // 更新专注总时间 - 计算已专注的时间
                const focusedTime = parseInt(focusTimeInput.value) - Math.floor(timeLeft / 60);
                totalFocusTime += focusedTime;
                totalTimeElement.textContent = totalFocusTime;
                
                cycleCount++;
                
                if (cycleCount % parseInt(cyclesInput.value) === 0) {
                    mode = 'longBreak';
                    timeLeft = parseInt(longBreakInput.value) * 60;
                } else {
                    mode = 'shortBreak';
                    timeLeft = parseInt(shortBreakInput.value) * 60;
                }
            } else {
                mode = 'focus';
                timeLeft = parseInt(focusTimeInput.value) * 60;
            }
            
            originalTime = timeLeft;
            updateModeDisplay();
            updateTimeDisplay();
        }

        // 切换设置面板
        function toggleSettings() {
            settingsContent.classList.toggle('active');
        }

        // 渲染任务列表
        function renderTasks() {
            taskList.innerHTML = '';
            
            tasks.forEach(task => {
                const taskItem = document.createElement('div');
                taskItem.className = 'task-item';
                taskItem.innerHTML = `
                    <div class="task-check ${task.completed ? 'completed' : ''}" data-id="${task.id}"></div>
                    <div class="task-name">${task.name}</div>
                    <div class="task-time">${task.completed ? '已完成' : '待完成'}</div>
                `;
                taskList.appendChild(taskItem);
                
                // 添加任务切换完成状态事件
                taskItem.querySelector('.task-check').addEventListener('click', function() {
                    const taskId = parseInt(this.getAttribute('data-id'));
                    toggleTaskCompletion(taskId);
                });
            });
            
            // 更新任务完成率
            updateCompletionRate();
        }

        // 添加新任务
        function addNewTask() {
            const taskName = newTaskInput.value.trim();
            if (!taskName) return;
            
            const newTask = {
                id: Date.now(),
                name: taskName,
                completed: false
            };
            
            tasks.push(newTask);
            newTaskInput.value = '';
            renderTasks();
        }

        // 切换任务完成状态
        function toggleTaskCompletion(taskId) {
            tasks = tasks.map(task => {
                if (task.id === taskId) {
                    return { ...task, completed: !task.completed };
                }
                return task;
            });
            
            renderTasks();
        }

        // 更新任务完成率
        function updateCompletionRate() {
            const total = tasks.length;
            const completed = tasks.filter(task => task.completed).length;
            const rate = total > 0 ? Math.round((completed / total) * 100) : 0;
            
            completionRateElement.textContent = `${rate}%`;
        }

        // 事件监听器
        startBtn.addEventListener('click', startTimer);
        resetBtn.addEventListener('click', resetTimer);
        skipBtn.addEventListener('click', skipTimer);
        settingsBtn.addEventListener('click', toggleSettings);
        
        saveSettingsBtn.addEventListener('click', () => {
            // 保存设置后更新当前时间
            if (mode === 'focus') {
                timeLeft = parseInt(focusTimeInput.value) * 60;
            } else if (mode === 'shortBreak') {
                timeLeft = parseInt(shortBreakInput.value) * 60;
            } else {
                timeLeft = parseInt(longBreakInput.value) * 60;
            }
            
            originalTime = timeLeft;
            updateTimeDisplay();
            toggleSettings();
        });
        
        cancelSettingsBtn.addEventListener('click', toggleSettings);
        
        addTaskBtn.addEventListener('click', addNewTask);
        newTaskInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                addNewTask();
            }
        });

        // 初始化
        updateTimeDisplay();
        updateModeDisplay();
        renderTasks();
    </script>
</body>
</html>