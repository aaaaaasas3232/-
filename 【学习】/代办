## 综合练习：拼出小听的桌面层

### 目标

用学过的所有知识，把小听桌面的核心结构拼出来。

```html
<!-- 综合练习.html -->
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>综合：拼出小听桌面</title>
    <style>
        /* 基础样式（来自 main.css 的简化版） */
        body { margin: 0; background: #000; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .phone-case {
            width: 375px; height: 812px;
            background: #111;
            border-radius: 40px;
            overflow: hidden;
            position: relative;
        }
        .screen {
            width: 100%; height: 100%;
            position: relative;
            overflow: hidden;
            color: white;
        }
        .wallpaper {
            position: absolute; inset: 0;
            /* 渐变壁纸 */
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }

        /* 桌面层（根据 ready 显示） */
        .main-desktop {
            position: absolute; inset: 0;
        }
        .desktop-pages {
            display: flex;
            width: 300%;
            transition: transform 0.3s;
        }
        .desktop-page {
            width: 100%; flex-shrink: 0;
            padding: 20px;
            box-sizing: border-box;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            align-content: start;
        }

        /* App 图标 */
        .app-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }
        .app-icon-img {
            width: 54px; height: 54px;
            background: rgba(255,255,255,0.1);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 28px;
        }
        .app-icon-label {
            font-size: 11px;
            color: rgba(255,255,255,0.9);
            text-shadow: 0 1px 3px rgba(0,0,0,0.5);
            text-align: center;
            max-width: 70px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* 抖动效果（编辑模式） */
        @keyframes wiggle {
            0%,100% { transform: rotate(-3deg); }
            50% { transform: rotate(3deg); }
        }
        .app-icon.wiggle .app-icon-img {
            animation: wiggle 0.3s infinite;
        }

        /* 分页小圆点 */
        .page-dots {
            position: absolute;
            bottom: 80px;
            left: 50%; transform: translateX(-50%);
            display: flex; gap: 6px;
        }
        .page-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: rgba(255,255,255,0.3);
            transition: all 0.2s;
        }
        .page-dot.active {
            background: #fff;
            width: 20px;
            border-radius: 4px;
        }

        /* Dock 栏 */
        .dock-bar {
            position: absolute;
            bottom: 20px;
            left: 50%; transform: translateX(-50%);
            display: flex; gap: 8px;
            background: rgba(255,255,255,0.15);
            padding: 8px 16px;
            border-radius: 24px;
            backdrop-filter: blur(10px);
        }
        .dock-app {
            width: 44px; height: 44px;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px;
            cursor: pointer;
        }
        .dock-divider {
            width: 1px; height: 36px;
            background: rgba(255,255,255,0.3);
            align-self: center;
        }

        /* 状态栏 */
        .status-bar {
            position: absolute; top: 0; left: 0; right: 0;
            padding: 10px 20px;
            display: flex; justify-content: space-between;
            font-size: 14px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div id="app">
        <div class="phone-case">
            <div class="screen">
                <div class="wallpaper"></div>

                <!-- 主桌面层（等 ready 才出现） -->
                <div class="main-desktop" v-if="ready">

                    <!-- 滑动层 -->
                    <div
                        class="desktop-pages"
                        :style="{ transform: `translateX(${-currentPage * (100/1)}%)` }"
                    >
                        <!-- 每一页 -->
                        <div
                            class="desktop-page"
                            v-for="(page, pi) in desktopPages"
                            :key="pi"
                        >
                            <!-- 每一个 App 图标 -->
                            <div
                                class="app-icon"
                                v-for="app in page"
                                :key="app.id"
                                :class="{ wiggle: isEditMode && app.id !== 'home' }"
                                @click="openApp(app)"
                            >
                                <div class="app-icon-img">{{ app.icon }}</div>
                                <div class="app-icon-label">{{ app.name }}</div>
                            </div>
                        </div>
                    </div>

                    <!-- 小圆点 -->
                    <div class="page-dots">
                        <div
                            v-for="(_, i) in desktopPages"
                            :key="i"
                            class="page-dot"
                            :class="{ active: currentPage === i }"
                        ></div>
                    </div>

                    <!-- Dock 栏 -->
                    <div class="dock-bar">
                        <template v-for="app in dockApps" :key="app.id">
                            <div v-if="app.divider" class="dock-divider"></div>
                            <div v-else class="dock-app" @click="openApp(app)">
                                {{ app.icon }}
                            </div>
                        </template>
                    </div>
                </div>

                <!-- 状态栏（始终显示） -->
                <div class="status-bar">
                    <span>{{ currentTime }}</span>
                    <span>信号 电量</span>
                </div>

                <!-- 加载封面 -->
                <div v-if="!ready" class="status-bar">
                    <span>加载中...</span>
                </div>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script>
        createApp({
            data() {
                return {
                    currentPage: 0,
                    currentApp: null,
                    currentTime: '',
                    ready: false,
                    isEditMode: false,

                    // 每个 App 在哪一页、第几个
                    appPositions: {
                        'music':   { page: 0, index: 0, size: '1x1' },
                        'chat':    { page: 0, index: 1, size: '1x1' },
                        'weather': { page: 0, index: 2, size: '1x1' },
                        'camera':  { page: 0, index: 3, size: '1x1' },
                        'photos':  { page: 1, index: 0, size: '1x1' },
                        'setting': { page: 1, index: 1, size: '1x1' },
                    },

                    // App 名称和图标（类似 window.apps）
                    apps: {
                        'music':   { name: '音乐',   icon: '🎵' },
                        'chat':    { name: '聊天',   icon: '💬' },
                        'weather': { name: '天气',   icon: '☀️' },
                        'camera':  { name: '相机',   icon: '📷' },
                        'photos':  { name: '相册',   icon: '📸' },
                        'setting': { name: '设置',   icon: '⚙️' },
                        'home':    { name: '首页',   icon: '🏠' },
                    },

                    dockApps: [
                        { id: 'music', icon: '🎵' },
                        { id: 'chat',  icon: '💬' },
                        { divider: true },
                        { id: 'home',  icon: '🏠' },
                    ],
                }
            },

            computed: {
                desktopPages() {
                    const pageMap = {}
                    Object.entries(this.appPositions).forEach(([appId, pos]) => {
                        if (!pageMap[pos.page]) pageMap[pos.page] = []
                        const appInfo = this.apps[appId]
                        if (appInfo) {
                            pageMap[pos.page].push({
                                id: appId,
                                name: appInfo.name,
                                icon: appInfo.icon,
                                index: pos.index,
                            })
                        }
                    })
                    Object.values(pageMap).forEach(arr => arr.sort((a, b) => a.index - b.index))
                    const maxPage = Object.keys(pageMap).length || 1
                    return Array.from({ length: maxPage }, (_, i) => pageMap[i] || [])
                },

                pageCount() {
                    return this.desktopPages.length
                }
            },

            methods: {
                openApp(app) {
                    if (app.id === 'home') {
                        this.isEditMode = !this.isEditMode
                        return
                    }
                    console.log('打开应用：', app.name)
                },

                updateTime() {
                    const now = new Date()
                    this.currentTime = now.getHours().toString().padStart(2,'0') + ':' +
                                       now.getMinutes().toString().padStart(2,'0')
                },
            },

            mounted() {
                this.updateTime()
                setInterval(() => this.updateTime(), 1000)

                // 模拟异步加载
                setTimeout(() => {
                    this.ready = true
                }, 1000)
            }
        }).mount('#app')
    </script>
</body>
</html>
```

